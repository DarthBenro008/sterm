{
  "name": "sterm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "description": "Remote-first persistent terminal workspaces for AI-agent-heavy server workflows.",
  "workspaces": [
    "apps/desktop/web",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --workspaces build",
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun run --workspaces test",
    "desktop:dev": "cd apps/desktop/src-tauri && bunx tauri dev",
    "desktop:build": "bash scripts/package-desktop.sh",
    "desktop:signing-check": "bash scripts/check-release-signing.sh",
    "agent:build": "bash scripts/build-agent.sh",
    "release:check": "bash scripts/check-artifact-policy.sh && bash scripts/check-doctor-output.sh && bash scripts/build-agent.sh && bash scripts/check-release-artifacts.sh",
    "final:check": "bash scripts/check-final-readiness.sh",
    "verify:production": "bash scripts/check-production-readiness.sh",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.1",
    "@types/bun": "1.3.4",
    "typescript": "6.0.3"
  }
}
